{
    "name": "@juannpz/deno-service-tools",
    "description": "A Deno library for building backend services & servers with Hono, offering strongly-typed route parameters, custom and pre-configured middleware, route grouping, and parameter validation.",
    "version": "0.9.0",
    "license": "MIT",
    "author": "juannpz <juannpz@proton.me>",
    "repository": {
        "type": "git",
        "url": "https://github.com/juannpz/deno-service-tools.git"
    },
    "keywords": [
        "deno",
        "server",
        "middleware",
        "tools",
        "http",
        "hono"
    ],
    "exports": "./mod.ts",
    "tasks": {
        "test": "deno test",
        "check": "deno check mod.ts",
        "build:npm": "deno run -A build_npm.ts",
        "publish:jsr": "deno publish --no-check",
        "publish:npm": "cd npm && npm publish"
    },
    "imports": {
        "hono": "jsr:@hono/hono@4.7.8",
        "jose": "jsr:@panva/jose@^6"
    },
    "fmt": {
        "include": [
            "src/",
            "tests/",
            "mod.ts",
            "deps.ts",
            "deno.json"
        ],
        "indentWidth": 4,
        "singleQuote": true,
        "lineWidth": 80
    },
    "lint": {
        "rules": {
            "tags": ["recommended"]
        },
        "include": [
            "src/",
            "tests/",
            "mod.ts",
            "deps.ts",
            "deno.json"
        ],
        "exclude": [
            "vendor_imports.ts",
            "vendor/"
        ]
    },
    "publish": {
        "include": [
            "mod.ts",
            "deps.ts",
            "src/",
            "LICENSE",
            "README.md"
        ],
        "exclude": [
            "tests/",
            "vendor_imports.ts",
            "vendor/"
        ]
    },
    "vendor": false
}
